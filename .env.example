# Copy to .env.local for local development, or set these in Vercel / Render before building.
# Base URLs, without the trailing /upload.

# YAGCC proxy (https://github.com/lswiderski/yet-another-garmin-connect-client)
NEXT_PUBLIC_YAGCC_URL=https://your-yagcc-instance.example.com

# bodycomposition-webapi proxy (https://github.com/lswiderski/bodycomposition-webapi)
NEXT_PUBLIC_BODYCOMPOSITION_WEBAPI_URL=https://your-bodycomposition-webapi-instance.example.com
